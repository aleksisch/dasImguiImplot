options gen2
require daslib/fio

[export]
def initialize(project_path : string) {
    if (das_is_dll_build()) {
        register_dynamic_module("{project_path}/dasModuleImplot.shared_module", "Module_dasIMPLOT")
    }
    register_native_path("imgui", "imgui_implot_boost", "{project_path}/daslib/implot_boost.das")
    // v2/app/playwright/theme wrapper modules are registered here as they are added.
}
