options gen2
require daslib/daspkg

[export]
def package() {
    package_name("dasImguiImplot")
    package_description("ImPlot bindings for daslang")
    package_author("borisbat")
    package_license("MIT")
    package_tag("gui")
    package_tag("imgui")
    package_tag("plot")
}

[export]
def dependencies(version : string) {
    require_package("dasImgui")
}

[export]
def build() {
    cmake_build()
}
